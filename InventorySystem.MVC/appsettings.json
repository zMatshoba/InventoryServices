{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HttpClientBase": {
    "InventorySystemBaseAddress": "#{InventorySystemBaseAddress}#"
  },
  "ApiEndpoints": {
    "GetProducts": "api/product",
    "GetProduct": "api/product/{sku}",
    "CreateProduct": "api/product",
    "UpdateProduct": "api/product/{sku}/update-product",
    "StockAdjustment": "api/product/{sku}/stock-adjustments",
    "CreateOrder": "api/order",
    "GetOrders": "api/order",
    "GetDailySalesSummary": "api/report/daily-sales-summary?startdate={startdate}&enddate={enddate}"
  }
}
