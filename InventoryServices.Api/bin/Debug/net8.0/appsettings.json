{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level}] <{SourceContext}> {NewLine}TraceId: {TraceId} {NewLine}{Message:lj} {NewLine}{Exception}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "Path": "C:\\Logs\\InventorySystem\\InventorySystemAPI\\InventorySystemAPI-.txt",
          "RollingInterval": "Day",
          "OutputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level}] <{SourceContext}> {NewLine}TraceId: {TraceId} {NewLine}{Message:lj} {NewLine}{Exception}{NewLine}",
          "RetainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InventoryDb": "#{InventoryDb}#"
  }
}
